PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=security@yourdomain.com
BREVO_SENDER_NAME=ProTrade Security

# Database backups
PROTRADE_BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

MONGODB_DB_NAME=test

# Authenticator two-factor authentication
TWO_FACTOR_ISSUER=ProTrade
TWO_FACTOR_CHALLENGE_MINUTES=5
TWO_FACTOR_ENCRYPTION_KEY=replace_with_32_byte_base64_key
TWO_FACTOR_CHALLENGE_SECRET=replace_with_random_secret
TWO_FACTOR_RECOVERY_PEPPER=replace_with_random_secret
